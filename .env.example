# Root environment file for docker compose. Copy to .env next to
# docker-compose.yml and fill in. (client/.env.example and server/.env.example
# cover running the app outside Docker.)

# GitHub user/org the image is published under: ghcr.io/<owner>/bustbudget
GHCR_OWNER=snikanes

# Image tag to run. `latest` follows main; pin a version tag for stability.
BUSTBUDGET_TAG=latest

# Host directory holding budget.db. Mounted at /config in the container.
BUSTBUDGET_DATA=./data

# JWT signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# Access token lifetime (default 1d). Always give it a unit: 15m, 1h, 7d.
# A bare number is read as seconds.
JWT_ACCESS_TOKEN_EXPIRY=1d

# Do NOT set NODE_ENV here. The image already sets it to production, and
# env_file overrides the image, which would turn off the Secure flag on auth
# cookies.

# Google OAuth client id, used by the server to verify id tokens.
# The client bundle needs the same value at BUILD time, passed as the
# VITE_GOOGLE_CLIENT_ID build arg (CI reads it from the GOOGLE_CLIENT_ID
# repository variable).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
